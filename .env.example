# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
# Must be the service_role secret (JWT role claim = service_role), NOT the anon key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Backend — use Session pooler on Windows / IPv4-only networks (direct db.* host is IPv6-only).
# Supabase Dashboard → Connect → Session pooler → URI, then set driver to postgresql+asyncpg
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:password@aws-0-REGION.pooler.supabase.com:5432/postgres
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1024
ENVIRONMENT=development
SUPABASE_STORAGE_BUCKET=hand-histories

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
